# Copy to .env for local work. Never commit .env.
# With every provider key blank the app still runs: manual product entry and assisted rooms work.

ROOMSET_ENV=dev

# Local default is SQLite. In production use Postgres (Supabase pooler URL).
DATABASE_URL=sqlite:///./data/roomset.db

# local | s3. The free Render disk is wiped on each restart, so production needs s3.
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data/artifacts
S3_ENDPOINT_URL=
S3_BUCKET=roomset
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# Providers. Keys stay on the server.
BASETEN_API=
BASETEN_MODEL=meta-models/muse-spark-open-1026
MUSE_API=
# Optional. With BASETEN_API, turns on the voice assistant on /ar.
ASSEMBLYAI_API=

# local = trimesh on this machine (free, CPU). modal = Blender on Modal.
SCENE_BUILDER=local
MODAL_APP_NAME=roomset-worker
# Experimental photo draft: enable only after a real GPU reconstruction has been verified.
RECONSTRUCTION_ENABLED=false
RECONSTRUCTION_DAILY_LIMIT=3
# Modal SDK reads these two.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Model API spending guard, kept in backend/data/spend.json. Modal compute is separate.
SPEND_LIMIT_USD=10
DAILY_SPARK_CALLS=200
DAILY_SPEECH_CALLS=150
DAILY_IMAGE_CALLS=40

# Limits
MAX_CONCURRENT_JOBS=2
MAX_RENDERS_PER_SESSION=10
RETENTION_DAYS=7
